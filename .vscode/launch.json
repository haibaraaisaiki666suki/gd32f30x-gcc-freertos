{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (pyOCD / PWLINK2)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "pyocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/aaa_generic_project_name.elf",
      "targetId": "gd32f303vc",
      "interface": "swd",
      "cmsisPack": "${workspaceFolder}/packs/GigaDevice.GD32F30x_DFP.2.6.0.pack",
      "svdFile": "${workspaceFolder}/svd/GD32F30x_HD.svd",
      "overrideGDBServerStartedRegex": "GDB server (started (at|on)|listening on) port",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none"
    }
  ]
}
